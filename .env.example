# ------------------------------
# Model API (OpenAI-compatible)
# ------------------------------
MODEL_API_URL=https://api.openai.com/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_TOKENS=8000

# ------------------------------
# Local web server
# ------------------------------
PORT=8787

# ------------------------------
# WeCom robot push
# ------------------------------
WECHAT_WEBHOOK_URL=
RISK_WEBHOOK_URL=

# ------------------------------
# Analysis / reporting
# ------------------------------
CLASSIFY_DAYS=7
SUMMARY_INTERVAL_MINUTES=0
REPORT_DAILY_HOUR=9
AUTO_PUSH_DAILY=false
AUTO_PUSH_WEEKLY=false
IGNORE_SENDERS=

# ------------------------------
# Optional authorized WeCom collection adapter
# The public repository does not include a production collection implementation.
# ------------------------------
WECOM_PYTHON=python3
WECOM_PRO_PATH=
WECOM_DATA_DIR=
WECOM_CHAT_NAME=
